#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
#
NODE_ENV=

#PORT of running APP
PORT=

#MONGO URI for main DB
MONGO_URL=

#REDIS URI for main DB
REDIS_URL=

#MONGO DB NAME for main DB
DB_NAME=

#POSTGRES HOST for main DB
POSTGRES_HOST=

#POSTGRES PORT for main DB
POSTGRES_PORT=

#POSTGRES USERNAME for main DB
POSTGRES_USERNAME=

#POSTGRES PASSWORD for main DB
POSTGRES_PASSWORD=

#POSTGRES DB NAME for main DB
POSTGRES_DB=

# Postgres SSL: true for Neon (production), false for local Docker
POSTGRES_SSL=

# Default admin username, must be changed for production
ADMIN_USERNAME=

# Default admin password, must be changed for production
ADMIN_PASSWORD=

# Secret key used to sign the access token
AC_SECRET=

# Secret key used to sign the refresh token
RT_SECRET=

# Email account used for sending system emails
EMAIL=

# Password/app-password for the email account
EMAIL_PASS=

# Should Swagger be enabled
IS_SWAGGER_ENABLED=

# Testing module provides controllers and logic to facilitate testing, e.g. DELETE ALL DATA. Dangerous, should be false for most environments
INCLUDE_TESTING_MODULE=

#APPLICATION/DOMAIN SETTINGS
# Access token lifetime
AC_TIME=15m

# Refresh token lifetime
RT_TIME=30d